{
  "expo": {
    "name": "Paisa Voice",
    "slug": "paisa-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paisa-voice",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f8f4"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Paisa Voice uses your microphone to listen for spoken commands like \"send ₹500 to Ramesh\".",
        "NSSpeechRecognitionUsageDescription": "Paisa Voice converts your spoken commands to text on-device to fill in payments."
      },
      "bundleIdentifier": "com.anonymous.paisavoice"
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.paisavoice"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Paisa Voice uses your camera to scan UPI QR codes so you can pay faster."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
